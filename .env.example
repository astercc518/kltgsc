# =============================================
# TGSC 环境变量配置模板
# 基础设施变量: cp .env.example .env 然后填入真实值
# 应用变量: cp backend/.env.example backend/.env 然后填入真实值
# 生产启动前先运行: cd landing && npm ci && npm run build
# 警告: .env 文件不要提交到 Git!
# =============================================

# ===== 数据库 =====
POSTGRES_USER=tgsc_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=tgsc_prod

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_use_a_strong_password

# ===== 应用安全 =====
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_use_a_strong_password

# ===== Session 加密 =====
SESSION_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ===== 第三方服务 =====
SMS_ACTIVATE_API_KEY=
IP2WORLD_API_URL=
